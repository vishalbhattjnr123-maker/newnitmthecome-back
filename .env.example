# Local server configuration
PORT=5000
NODE_ENV=development
SERVE_STATIC=false
GST_RATE=0

# Vercel Blob storage (optional for local development; required for persistent production uploads)
BLOB_STORE_ID=
DB_BLOB_READ_WRITE_TOKEN=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Razorpay (required for checkout/payment)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
